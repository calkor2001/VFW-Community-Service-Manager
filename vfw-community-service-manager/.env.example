# Web server
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-string
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Existing Formspree form. The manager forwards every accepted intake here
# so the current Yahoo email notification workflow can continue.
FORMSPREE_ENDPOINT=https://formspree.io/f/xnpagjag

# Indiana VFW login - DO NOT commit real credentials.
VFW_MEMBER_ID=your-member-id
VFW_PASSWORD=your-new-password
VFW_SUBMITTER_EMAIL=vfwcarmel@yahoo.com
VFW_POST=10003
VFW_DISTRICT=6

# Safety switch. Leave false while validating field mapping.
# false = prepare the official form and save a screenshot, but DO NOT click SUBMIT.
# true  = after dashboard approval, click the official Indiana SUBMIT button.
VFW_ALLOW_FINAL_SUBMIT=false

# Optional base URLs/selectors. Keep configurable in case Indiana changes its site.
VFW_MEMBERS_URL=https://vfwin.org/di/vfw/v2/default.asp?nid=10&ohr=y#c
VFW_PROGRAM_REPORTING_URL=https://vfwin.org/di/vfw/v2/default.asp?nid=10&cmr=INCSR#c

# Temporary testing only; turn off after validation
ENABLE_TEST_REPORTS=false
